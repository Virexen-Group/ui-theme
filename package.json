{
  "name": "@virexen-group/ui-theme",
  "version": "0.2.0",
  "description": "Shared Virexen design system, themes, UI components, typography, fonts and email utilities for all Virexen platforms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Virexen-Group/ui-theme.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json",
    "./fonts/*": "./dist/fonts/*",
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:assets": "node scripts/build-assets.mjs",
    "build:components": "vite build",
    "build": "pnpm clean && pnpm build:assets && pnpm build:components",
    "lint": "stylelint 'src/**/*.css'",
    "typecheck": "vue-tsc --noEmit -p tsconfig.components.json",
    "prepublishOnly": "pnpm build",
    "test": "node --test tests/*.test.js",
    "dev:sandbox": "vite --config vite.sandbox.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
